# AG2 Router Configuration Example
# Copy to .env to override defaults

# Port for local loopback dashboard & API (default: 39250)
PORT=39250

# Path to store non-secret metadata (default: ./data)
DATA_DIR=./data

# Enable automated account switching (default: false)
AUTO_SWITCH=false

# Percentage threshold below which current account is considered low (default: 15)
LOW_QUOTA_THRESHOLD=15

# Minimum percentage quota a candidate account must have to be eligible (default: 30)
MIN_CANDIDATE_QUOTA=30

# Polling interval in milliseconds for AG2 telemetry checks (default: 10000)
POLL_INTERVAL_MS=10000
