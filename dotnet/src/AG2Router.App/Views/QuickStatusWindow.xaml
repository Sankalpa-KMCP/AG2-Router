<Window x:Class="AG2Router.App.Views.QuickStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AG2 Router Quick Status"
        Width="320" Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Border Background="#0F1115"
            BorderBrush="#272C38"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#656D7D" Margin="0,0,8,0"/>
                    <TextBlock Text="AG2 Router" FontWeight="Bold" FontSize="13" Foreground="#F0F2F5"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Foundation" FontSize="10" Foreground="#656D7D" VerticalAlignment="Center"/>
            </Grid>

            <Separator Grid.Row="1" Background="#272C38" Margin="0,0,0,10"/>

            <!-- Metric Cards (2x2 Grid) -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Antigravity Status -->
                <Border Grid.Row="0" Grid.Column="0" Background="#161920" CornerRadius="6" BorderBrush="#272C38" BorderThickness="1" Margin="0,0,4,4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Antigravity" FontSize="11" Foreground="#9AA2B2"/>
                        <TextBlock x:Name="TxtStatus" Text="Not connected" FontWeight="SemiBold" FontSize="12" Foreground="#F0F2F5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Account -->
                <Border Grid.Row="0" Grid.Column="1" Background="#161920" CornerRadius="6" BorderBrush="#272C38" BorderThickness="1" Margin="4,0,0,4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Account" FontSize="11" Foreground="#9AA2B2"/>
                        <TextBlock x:Name="TxtAccount" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="#F0F2F5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Quota -->
                <Border Grid.Row="1" Grid.Column="0" Background="#161920" CornerRadius="6" BorderBrush="#272C38" BorderThickness="1" Margin="0,4,4,0" Padding="8">
                    <StackPanel>
                        <TextBlock x:Name="LblQuota" Text="Model Quota" FontSize="11" Foreground="#9AA2B2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtQuota" Text="—%" FontWeight="SemiBold" FontSize="12" Foreground="#F0F2F5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Auto Switch -->
                <Border Grid.Row="1" Grid.Column="1" Background="#161920" CornerRadius="6" BorderBrush="#272C38" BorderThickness="1" Margin="4,4,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Auto Switch" FontSize="11" Foreground="#9AA2B2"/>
                        <TextBlock x:Name="TxtAutoSwitch" Text="Not available" FontWeight="SemiBold" FontSize="12" Foreground="#F0F2F5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action Button -->
            <Button Grid.Row="3" x:Name="BtnOpenDashboard"
                    Content="Open Full Dashboard"
                    Background="#3B82F6"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Height="32"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnOpenDashboard_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
