<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0</AssemblyVersion>
    <FileVersion>0.3.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <Product>AG2 Router</Product>
    <Description>Lightweight Windows application foundation for Antigravity 2 quota monitoring and safe account routing.</Description>
    <!-- Resolves repository root reliably regardless of project nesting -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
  </PropertyGroup>
</Project>
